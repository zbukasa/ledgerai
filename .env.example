# --- Required secrets (server refuses to start if any are missing / < 16 chars) ---
# Generate strong random values, e.g.  openssl rand -base64 48
JWT_SECRET=
INTERNAL_API_KEY=
BANK_TOKEN_ENCRYPTION_KEY=

# --- Database ---
DATABASE_URL=postgresql://user:password@host:port/dbname

# --- Runtime ---
NODE_ENV=development
# Optional: JWT lifetime (default 2h)
JWT_EXPIRES_IN=2h
# Comma-separated allowlist of browser origins for CORS/WebSocket in production
# (e.g. https://app.ledgerai.com,https://www.ledgerai.com). Ignored in development.
ALLOWED_ORIGINS=

# --- Server-side API keys (never exposed to the client bundle) ---
GEMINI_API_KEY=
GOOGLE_MAPS_API_KEY=
